# =====================================================================
# [안내] 이 파일은 어떤 API 키가 필요한지 보여주기 위한 '예시 템플릿'입니다.
# 실제 API 키는 이 파일에 적지 마시고, 반드시 '.env' 라는 이름의 새 파일을 만들어서 입력하세요!
# =====================================================================

# 1. OpenAI API 키 (GPT 모델을 활용한 도시 추천, 일정 생성용)
# 발급: https://platform.openai.com
OPENAI_API_KEY=your_openai_api_key_here

# 2. Kakao REST API 키 (카카오 로컬 API를 활용한 맛집 검색 및 위경도 추출용)
# 발급: https://developers.kakao.com
KAKAO_REST_API_KEY=your_kakao_rest_api_key_here